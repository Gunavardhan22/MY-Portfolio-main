# Copy this file to .env and fill in real values. Never commit .env.

# Voice provider adapter (server/services/voiceProvider.js). Supported: groq
VOICE_PROVIDER=groq

# Your provider API key. Server-side only: it is never sent to the browser.
VOICE_API_KEY=your-groq-api-key-here

# Groq text-to-speech model and voice (https://console.groq.com/docs/text-to-speech)
# English voices: autumn, diana, hannah, austin, daniel, troy
VOICE_MODEL=canopylabs/orpheus-v1-english
VOICE_NAME=troy

# Where generated audio is cached (outside the public files)
VOICE_CACHE_DIR=.cache/voice

# Server
PORT=3000

# Only if the static site is hosted on a different origin than this server,
# e.g. https://gunavardhan22.github.io
ALLOWED_ORIGIN=

# Set to 1 behind a reverse proxy (Render, Railway, Nginx) so rate limits use the real client IP
TRUST_PROXY=0
