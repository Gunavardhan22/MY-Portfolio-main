# Copy this file to .env and fill in real values. Never commit .env.

# "Ask About Me" assistant (server/services/askService.js). Supported provider: groq
# Optional: without a key the site works fully, and the spoken introduction uses
# the browser's voice; only the "Ask About Me" button is hidden.
AI_PROVIDER=groq
AI_API_KEY=your-groq-api-key-here
AI_MODEL=openai/gpt-oss-20b

# Server
PORT=3000

# Only if the static site is hosted on a different origin than this server,
# e.g. https://gunavardhan22.github.io
ALLOWED_ORIGIN=

# Set to 1 behind a reverse proxy (Render, Railway, Nginx) so rate limits use the real client IP
TRUST_PROXY=0
